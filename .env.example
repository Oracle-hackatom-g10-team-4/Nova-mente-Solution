# NovaMente Atlas — somente valores de exemplo. Copie para .env, nunca commite .env.
# scripts/setup.sh cria um token interno aleatório se este campo estiver vazio.
ATLAS_INTERNAL_TOKEN=
# Controle de exigência de login (0 = desativado para dev local, 1 = ativado na OCI)
ATLAS_REQUIRE_LOGIN=0
ATLAS_APP_MODE=local
ATLAS_BIND_ADDRESS=127.0.0.1
ATLAS_TENANT_ID=local-workspace
ATLAS_SEED_DEMO=1
ATLAS_DATA_DIR=../../data
API_PORT=4000
ATLAS_API_URL=http://127.0.0.1:4000
COGNITION_URL=http://127.0.0.1:8000

# Node 24: respeitar HTTP_PROXY/HTTPS_PROXY e NO_PROXY quando injetados.
# Não substitui a CA confiável nem desabilita verificação TLS.
NODE_USE_ENV_PROXY=1

# Decision model / juiz TypeSafe (Jev). Portal oficial: https://typesafe.ai/
# Nunca usar NEXT_PUBLIC_ para chaves. Sem chave, política local e judge not_evaluated.
TYPESAFE_API_KEY=

# Geração: adapter formato OpenAI chat/completions + response_format JSON.
# Preencha somente após confirmar o contrato do fornecedor. Não presumimos que
# SubQ Snap é compatível; IDs, URL e quotas aguardam docs oficiais https://subq.ai/.
# A base deve terminar em /v1 se isso fizer parte do contrato real.
# Usado apenas com ATLAS_AGENT_RUNTIME=direct (modo de diagnóstico explícito).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings são OPCIONAIS no fluxo cotidiano. Jev classifica, NÃO gera vetores.
# O edital exige uma prova vetorial para o aceite; não requer serviço dedicado/pago. O adapter chama /embeddings.
# Ao trocar modelo/dimensão, reindexe a biblioteca; não misturar índices.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
LM_CONTEXT_CHAR_BUDGET=24000

# Eve é o runtime principal de agentes, separado do frontend. Não se confunde com o engine Invokta
# embutido no Nest. Necessita configuração/chave de geração para executar agente.
ATLAS_AGENT_RUNTIME=eve
# Debate interno habilitado quando Eve + TypeSafe estiverem configurados.
# Usuário recebe somente a síntese; até 5 turnos sequenciais e deadline global.
ATLAS_TEAM_DEBATE=1
EVE_URL=
EVE_MODEL=
# Opcional: teto de contexto validado para o modelo. Evita buscar catálogo no build.
EVE_MODEL_CONTEXT_WINDOW=
EVE_SERVICE_TOKEN=
AI_GATEWAY_API_KEY=

# Busca hospedada Firecrawl /v2/search; nenhuma chave segue para o cliente.
FIRECRAWL_API_KEY=

# Persistência: local NÃO conclui requisito Oracle do hackathon.
STORAGE_PROVIDER=local
# Produção OCI: STORAGE_PROVIDER=oci e, preferencialmente, instance principal.
OCI_AUTH_MODE=instance_principal
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=
# Somente desenvolvimento com perfil OCI externo ao Git. Não copie PEM para .env.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

# Dreamer é núcleo: captura com consentimento, replay, promoção limitada, rollback.
# Um replay remoto por workspace/dia, até 3 casos. Sem chave não promove políticas.
DREAMER_INTERVAL_SECONDS=3600
# Vazio = mesmo serviço Python, processo desacoplado do frontend. Para outra VM
# OCI/Railway use HTTPS/rede privada, token próprio e identidade coerente de tenant.
MEMORY_SERVICE_URL=
MEMORY_SERVICE_TOKEN=

# CA pública usada somente pelo BuildKit. Nunca desabilite TLS para instalar.
# Em Linux o Compose usa /etc/ssl/certs/ca-certificates.crt por padrão.
ATLAS_BUILD_CA_BUNDLE=

# Índice opcional: sqlite (padrão) ou qdrant. Qdrant exige embeddings reais.
# Externo: URL HTTPS; compose.qdrant.yaml usa http://qdrant:6333 na rede interna.
VECTOR_BACKEND=sqlite
QDRANT_URL=
QDRANT_API_KEY=

# Projeção MongoDB externa opcional; textos/PDFs/memórias não são projetados.
# Instale requirements-mongo.lock; imagem Docker usa build arg ATLAS_WITH_MONGO=1.
# URI com usuário/senha é segredo: configure somente aqui ou no secret manager.
MONGODB_URI=
MONGODB_DATABASE=atlas

# Fila Dreamer: local (padrão) ou trigger (serviço externo, nunca self-host na VPS).
ATLAS_JOB_RUNNER=local
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_SECRET_KEY=
# Os três campos seguintes configuram o runner externo, não o navegador.
TRIGGER_PROJECT_REF=
ATLAS_JOB_CALLBACK_URL=
# Gere um token exclusivo de >=24 caracteres; não reutilize ATLAS_INTERNAL_TOKEN.
ATLAS_JOB_RUNNER_TOKEN=

# Cofre do painel /studio/settings. npm run init:vault gera 32 bytes em base64.
# Guarde backup separado do volume criptografado. Perder a chave perde o acesso.
ATLAS_CREDENTIAL_MASTER_KEY=
# Alternativa preferencial em produção: arquivo montado por Secret Manager/Vault.
ATLAS_CREDENTIAL_MASTER_KEY_FILE=
# Padrão: ATLAS_DATA_DIR/credentials/providers.enc; mesmo volume em API/Python/Eve.
ATLAS_CREDENTIALS_FILE=
# SDK independente no Eve: gateway (padrão), openrouter, openai ou anthropic.
EVE_MODEL_PROVIDER=gateway
OPENROUTER_API_KEY=
# Nome específico do app: não reutilizar OPENAI_API_KEY reservado pelo ambiente.
ATLAS_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Qualquer chave de provedor acima aceita NOME_DA_VARIAVEL_FILE (arquivo montado).
# Ex.: TYPESAFE_API_KEY_FILE=/run/secrets/typesafe_api_key
# ChatGPT por assinatura: APENAS dev local com /login do Eve, sem reutilizar
# credenciais da sessão Codex. Não habilitar em deployment nem em conta pública.
ATLAS_ALLOW_LOCAL_CHATGPT=0

# Deploy sem build na VPS. Identificadores públicos, não credenciais.
# Escolha o repositório que publicou o workflow manual de imagens.
ATLAS_IMAGE_PREFIX=ghcr.io/oracle-hackatom-g10-team-4/nova-mente-solution
# SHA completo do build publicado; não use main/latest para um rollback previsível.
ATLAS_IMAGE_TAG=

# Resiliência e limite do registro idempotente (Nest/SQLite, não memória LLM).
# Conteúdo dos recibos expira em 7 dias; as chaves ficam como tombstones e não
# são reexecutadas. Atingir a quota bloqueia comandos até manutenção explícita.
ATLAS_COMMAND_MAX_ROWS=20000
ATLAS_COMMAND_TTL_SECONDS=604800
ATLAS_COMMAND_MAX_BYTES=67108864
ATLAS_RATE_LIMIT_PER_MINUTE=120

# Configuração avançada de caminhos. Vazio usa os padrões documentados.
# ATLAS_DATA_DIR relativo é resolvido no cwd de cada serviço; em produção use /data.
ATLAS_ENV_FILE=
ATLAS_AGENT_CATALOG=

# Arquivos de segredo opcionais. O arquivo tem prioridade; se indicado, deve
# existir e ser legível. Paths são exemplos; monte-os via seu secret manager.
AI_GATEWAY_API_KEY_FILE=
OPENROUTER_API_KEY_FILE=
ATLAS_OPENAI_API_KEY_FILE=
ANTHROPIC_API_KEY_FILE=
TYPESAFE_API_KEY_FILE=
FIRECRAWL_API_KEY_FILE=
LLM_API_KEY_FILE=
EMBEDDING_API_KEY_FILE=

# Desenvolvimento/testes/qualidade — não necessários ao runtime da VPS.
# NODE_ENV é definido pelo Next/Docker; deixe vazio neste arquivo de exemplo.
NODE_ENV=
ATLAS_WEB_URL=http://127.0.0.1:3000
ATLAS_SMOKE_URL=http://127.0.0.1:3000/api/atlas
ATLAS_ACCEPTANCE_DOCUMENT_ID=
# Chromium já instalado no cloud: /usr/bin/chromium. CI usa o browser Playwright.
ATLAS_E2E_CHROMIUM=
# Gravador de demonstração da landing (canal Playwright instalado; só desenvolvimento).
ATLAS_DEMO_CHANNEL=chrome
# Só 1 quando conscientemente reutilizar um servidor de TESTE já ativo.
ATLAS_E2E_REUSE=0
ATLAS_QUALITY_ENGINE=
# Marcadores internos/documentados por completude; não configure estes campos.
# O supervisor define ENV_READY; os testes usam seus próprios valores isolados.
ATLAS_ENV_READY=
ATLAS_TEST_SELECTOR=
ATLAS_TEST_INJECTED=
# Definido pelo launcher desktop; não habilitar na VPS. Geração usa somente ponte loopback.
ATLAS_LOCAL_CHATGPT_PLAN=0
# Capability efêmera criada pelo desktop e injetada somente na janela autorizada. Não preencher na VPS.
ATLAS_DESKTOP_CAPABILITY=
